#!/usr/bin/make -f
#
# debian/rules for the open-vm-tools Wayland fork.
#
# packaging/debian/build.sh copies this directory into the unpacked source
# tree as debian/ and runs dpkg-buildpackage there.

%:
	dh $@

override_dh_auto_configure:
	# No --with-gtk4: configure prefers Gtkmm 4 and falls back to Gtkmm 3,
	# which is what the older releases this targets carry. Gtkmm 4 does not
	# reach Debian until 12 and Ubuntu until 24.04.
	dh_auto_configure -- \
		--disable-static \
		--disable-docs \
		--enable-resolutionkms \
		--enable-servicediscovery \
		--enable-vmwgfxctrl \
		--with-fuse \
		--with-tirpc \
		--with-wayland \
		--with-xmlsec1 \
		--without-kernel-modules

override_dh_auto_install:
	dh_auto_install

	# No -dev package is shipped, so the headers, the pkg-config files, the
	# libtool archives and the unversioned linker symlinks have nowhere to go.
	rm -rf debian/tmp/usr/include debian/tmp/usr/lib/*/pkgconfig
	find debian/tmp -name '*.la' -delete
	find debian/tmp/usr/lib -maxdepth 2 -name 'lib*.so' -delete

	# The tree ships a portable PAM file whose modules do not exist on
	# Debian; substitute the distribution one.
	install -m 0644 debian/open-vm-tools-wayland.pam \
		debian/tmp/etc/pam.d/vmtoolsd

	# udev.pc reports udevdir as /lib/udev on Debian 13 and Ubuntu 26.04 but
	# as /usr/lib/udev on Ubuntu 24.04. On a merged-usr system those are the
	# same directory, so settle on the spelling policy prefers and package
	# that one.
	if [ -d debian/tmp/lib/udev ]; then \
		install -d debian/tmp/usr/lib; \
		mv debian/tmp/lib/udev debian/tmp/usr/lib/udev; \
		rmdir debian/tmp/lib 2>/dev/null || true; \
	fi

	chmod a-x debian/tmp/etc/pam.d/vmtoolsd \
		debian/tmp/etc/vmware-tools/*.conf \
		debian/tmp/etc/vmware-tools/vgauth/schemas/* \
		debian/tmp/usr/lib/udev/rules.d/99-vmware-scsi-udev.rules

	# The autostart entry has no use for the legacy Encoding key.
	sed -i '/^Encoding/d' \
		debian/tmp/etc/xdg/autostart/vmware-user.desktop

	# The portal desktop entry names the app id the RemoteDesktop portal
	# resolves, so it only exists when the build found libei. Move it into
	# the desktop package here, because dh_install refuses a list entry that
	# matches nothing.
	if [ -f debian/tmp/usr/share/applications/org.openvm.tools.desktop ]; then \
		install -D -m 0644 \
			debian/tmp/usr/share/applications/org.openvm.tools.desktop \
			debian/open-vm-tools-wayland-desktop/usr/share/applications/org.openvm.tools.desktop; \
		rm -f debian/tmp/usr/share/applications/org.openvm.tools.desktop; \
	fi

override_dh_installsystemd:
	# vgauthd has to go in first. vmtoolsd.service names it in an [Install]
	# Also= directive, and dh_installsystemd resolves those against the
	# buildroot, so the unit must already be there when vmtoolsd is handled.
	dh_installsystemd --name=vgauthd --restart-after-upgrade
	dh_installsystemd --name=vmtoolsd --restart-after-upgrade
	dh_installsystemd --name='run-vmblock\x2dfuse'

override_dh_fixperms:
	dh_fixperms
	chmod 4755 debian/open-vm-tools-wayland-desktop/usr/bin/vmware-user-suid-wrapper
